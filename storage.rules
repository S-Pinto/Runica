rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // L'utente autenticato è il proprietario del percorso.
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Immagine raster valida (niente SVG/HTML) e sotto il limite indicato.
    function isValidImage(maxBytes) {
      return request.resource.size < maxBytes
          && request.resource.contentType.matches('image/(jpeg|png|webp|gif|avif)');
    }

    // Foto profilo: lettura, scrittura e cancellazione solo del proprietario.
    match /users/{userId}/profile.jpg {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidImage(500 * 1024);
    }

    // Ritratti dei personaggi.
    match /users/{userId}/character-portraits/{characterId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidImage(1024 * 1024);
    }

    // Ritratti dei compagni.
    match /users/{userId}/characters/{characterId}/companions/{companionId}/portrait.jpg {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidImage(1024 * 1024);
    }

    // Immagini degli oggetti.
    match /users/{userId}/characters/{characterId}/items/{itemId}/image.jpg {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidImage(1024 * 1024);
    }

    // Ritratti condivisi in una campagna (Fase G): il proprietario del personaggio ne carica
    // una copia, tutti i membri della campagna possono leggerla. L'appartenenza si verifica
    // sul documento members/{uid} di Firestore (database `runica-db`, vedi firebase.json).
    // Nota: l'URL di download restituito al caricamento contiene un token e funziona anche
    // fuori da queste regole; per questo viene salvato solo in sharedCharacters, leggibile
    // ai soli membri.
    function isCampaignMember(campaignId) {
      return request.auth != null
          && firestore.exists(/databases/runica-db/documents/campaigns/$(campaignId)/members/$(request.auth.uid));
    }

    match /campaigns/{campaignId}/portraits/{userId}/{characterId} {
      allow read: if isCampaignMember(campaignId);
      allow create, update: if isOwner(userId) && isCampaignMember(campaignId) && isValidImage(1024 * 1024);
      allow delete: if isOwner(userId);
    }

    // Tutto il resto è negato.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
