rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function signedIn() {
      return request.auth != null;
    }

    // Controlli di base sul documento di un personaggio: struttura e tipi dei
    // campi principali, per evitare documenti arbitrari o fuori scala.
    // (Firestore limita già a 1 MiB la dimensione di un documento.)
    function isValidCharacter() {
      let data = request.resource.data;
      return data is map
          && data.keys().size() <= 120
          && (!('name' in data) || (data.name is string && data.name.size() <= 200))
          && (!('level' in data) || (data.level is number && data.level >= 0 && data.level <= 20));
    }

    // Un utente può leggere e scrivere solo i propri personaggi.
    // L'ID utente nel percorso deve corrispondere all'ID dell'autenticazione.
    match /users/{userId}/characters/{characterId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidCharacter();
    }

    // ---------------------------------------------------------------------
    // Campagne condivise (Fase G)
    //
    //   campaigns/{id}                      DM = ownerUid, elenco membri in memberUids
    //   campaigns/{id}/members/{uid}        ruolo e nome visibile di ogni membro
    //   campaigns/{id}/sharedCharacters/{c} riepilogo del personaggio (mai la scheda intera)
    //   campaignInvites/{codice}            codice d'invito -> campagna (get, mai list)
    //
    // Le schede in users/{uid}/characters restano private: i membri vedono solo il riepilogo.
    // ---------------------------------------------------------------------

    function campaignDoc(campaignId) {
      return /databases/$(database)/documents/campaigns/$(campaignId);
    }

    function memberDoc(campaignId, userId) {
      return /databases/$(database)/documents/campaigns/$(campaignId)/members/$(userId);
    }

    function inviteDoc(code) {
      return /databases/$(database)/documents/campaignInvites/$(code);
    }

    // Membro della campagna secondo lo stato corrente (prima della scrittura).
    function isCampaignMember(campaignId) {
      return signedIn() && request.auth.uid in get(campaignDoc(campaignId)).data.memberUids;
    }

    function isCampaignOwner(campaignId) {
      return signedIn() && get(campaignDoc(campaignId)).data.ownerUid == request.auth.uid;
    }

    function isShortString(value, maxLen) {
      return value is string && value.size() <= maxLen;
    }

    function isValidCampaignText(data) {
      return isShortString(data.name, 120) && data.name.size() > 0
          && (!('description' in data) || isShortString(data.description, 2000));
    }

    // Il membro che sta per unirsi (scritto nello stesso batch) presenta un codice
    // che punta davvero a questa campagna.
    function hasValidJoinCode(campaignId, userId) {
      let member = getAfter(memberDoc(campaignId, userId)).data;
      return member.role == 'player'
          && member.joinCode is string
          && get(inviteDoc(member.joinCode)).data.campaignId == campaignId;
    }

    match /campaigns/{campaignId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;

      // Solo chi crea è il DM e il primo membro; il codice d'invito è creato nello stesso batch.
      allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['name', 'description', 'ownerUid', 'memberUids', 'inviteCode', 'createdAt', 'updatedAt'])
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.memberUids == [request.auth.uid]
          && isShortString(request.resource.data.inviteCode, 12)
          && isValidCampaignText(request.resource.data);

      allow update: if signedIn() && (
          // Il DM modifica i dettagli, rigenera il codice o rimuove membri (mai se stesso).
          (resource.data.ownerUid == request.auth.uid
            && request.resource.data.ownerUid == resource.data.ownerUid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['name', 'description', 'inviteCode', 'memberUids', 'updatedAt'])
            && request.resource.data.memberUids.hasAll([resource.data.ownerUid])
            && resource.data.memberUids.hasAll(request.resource.data.memberUids)
            && isValidCampaignText(request.resource.data))
          // Un giocatore entra: aggiunge solo se stesso, con un codice valido.
          || (!(request.auth.uid in resource.data.memberUids)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'updatedAt'])
            && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
            && request.resource.data.memberUids.hasAll(resource.data.memberUids)
            && request.auth.uid in request.resource.data.memberUids
            && hasValidJoinCode(campaignId, request.auth.uid))
          // Un giocatore esce: toglie solo se stesso (il DM non può uscire).
          || (request.auth.uid in resource.data.memberUids
            && request.auth.uid != resource.data.ownerUid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'updatedAt'])
            && request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1
            && resource.data.memberUids.hasAll(request.resource.data.memberUids)
            && !(request.auth.uid in request.resource.data.memberUids))
        );

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /members/{memberUid} {
        allow read: if isCampaignMember(campaignId);

        // Il DM crea il proprio documento insieme alla campagna; i giocatori entrano con un codice.
        allow create: if signedIn() && request.auth.uid == memberUid
            && request.resource.data.keys().hasOnly(['role', 'displayName', 'photoURL', 'joinedAt', 'joinCode'])
            && isShortString(request.resource.data.displayName, 120)
            && (
              (request.resource.data.role == 'dm'
                && getAfter(campaignDoc(campaignId)).data.ownerUid == request.auth.uid)
              || (request.resource.data.role == 'player'
                && request.resource.data.joinCode is string
                && get(inviteDoc(request.resource.data.joinCode)).data.campaignId == campaignId
                && request.auth.uid in getAfter(campaignDoc(campaignId)).data.memberUids)
            );

        // Ognuno aggiorna solo nome e foto del proprio profilo.
        allow update: if signedIn() && request.auth.uid == memberUid
            && request.resource.data.role == resource.data.role
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL'])
            && isShortString(request.resource.data.displayName, 120);

        // Si esce da soli, oppure il DM rimuove un giocatore.
        allow delete: if signedIn() && (request.auth.uid == memberUid || isCampaignOwner(campaignId));
      }

      match /sharedCharacters/{characterId} {
        allow read: if isCampaignMember(campaignId);

        allow create, update: if signedIn()
            && request.resource.data.ownerUid == request.auth.uid
            && (request.method == 'create' || resource.data.ownerUid == request.auth.uid)
            && isCampaignMember(campaignId)
            && request.resource.data.keys().hasOnly([
                 'ownerUid', 'name', 'class', 'subclass', 'race', 'level',
                 'hpCurrent', 'hpMax', 'hpTemp', 'armorClass',
                 'portraitUrl', 'portraitSource', 'lastUpdated'])
            && isShortString(request.resource.data.name, 200)
            && request.resource.data.level is number
            && request.resource.data.hpCurrent is number
            && request.resource.data.hpMax is number
            && request.resource.data.armorClass is number;

        // Lo ritira il proprietario del personaggio, oppure il DM.
        allow delete: if signedIn() && (resource.data.ownerUid == request.auth.uid || isCampaignOwner(campaignId));
      }
    }

    // Il codice è l'id del documento: si legge con get() da un utente autenticato, ma non si elenca.
    match /campaignInvites/{code} {
      allow get: if signedIn();
      allow list: if false;

      // Solo il DM crea l'invito, nello stesso batch della campagna (o alla rigenerazione).
      allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['campaignId', 'ownerUid', 'createdAt'])
          && request.resource.data.ownerUid == request.auth.uid
          && getAfter(campaignDoc(request.resource.data.campaignId)).data.ownerUid == request.auth.uid
          && getAfter(campaignDoc(request.resource.data.campaignId)).data.inviteCode == code;

      allow update: if false;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }
  }
}
